{
  "name": "invoice-pwa-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Progressive Web App for AI-powered invoice processing with offline capabilities",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:tsc": "tsc -b && vite build",
    "preview": "vite preview --host",
