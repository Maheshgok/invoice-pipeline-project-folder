rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read invoice results they own
    // This collection contains complete invoice data including journal entries
    match /invoice_results/{jobId} {
      allow read: if request.auth != null 
        && request.auth.token.email == resource.data.user_email;
      allow write: if false; // Only backend should write
    }
    
    // For development/testing only - remove in production
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}