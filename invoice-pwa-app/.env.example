# Copy from your original project and update for PWA
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API URLs (same as original project)
VITE_INITIAL_API_URL=https://your-initial-api.run.app
VITE_QUEUE_PROCESSOR_URL=https://your-queue-processor.run.app
VITE_ARCHIVE_MANAGER_URL=https://your-archive-manager.run.app

# PWA-specific configuration
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_for_push_notifications

# Environment
NODE_ENV=development